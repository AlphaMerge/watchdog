{
  "service": {
    "name": "ms-core",
    "dataDir": "/var/lib/ms-core",
    "logLevel": "info",
    "logPretty": false,
    "shutdownTimeoutMs": 20000
  },
  "api": {
    "host": "127.0.0.1",
    "port": 8080,
    "webRoot": "/opt/ms/web",
    "allowedOrigins": [],
    "allowedHosts": [],
    "trustedProxies": []
  },
  "sessions": {
    "idleTimeoutMinutes": 720,
    "absoluteTimeoutHours": 168
  },
  "heartbeat": {
    "url": "",
    "intervalSeconds": 300
  },
  "notifications": {
    "publicUrl": "",
    "siteName": "MonitoringSystem",
    "smtp": {
      "sender": "",
      "primary": {
        "host": "",
        "port": 587,
        "security": "starttls",
        "verifyCertificate": true,
        "auth": "none",
        "heloName": "",
        "timeoutMs": 20000
      },
      "fallback": {
        "host": "",
        "port": 0,
        "security": "starttls",
        "verifyCertificate": true,
        "auth": "none",
        "heloName": "",
        "timeoutMs": 20000
      }
    }
  },
  "database": {
    "host": "127.0.0.1",
    "port": 5432,
    "database": "monitoring",
    "user": "monitoring",
    "password": "",
    "ssl": false,
    "poolSize": 20,
    "connectTimeoutMs": 10000,
    "statementTimeoutMs": 60000,
    "lockTimeoutMs": 5000,
    "idleInTransactionTimeoutMs": 60000,
    "autoMigrate": true
  },
  "ingestion": {
    "queueMaxRows": 200000,
    "batchMaxRows": 1000,
    "batchMaxDelayMs": 250,
    "slowDownAtPercent": 50,
    "retryAfterMs": 1000,
    "replay": {
      "maxConcurrentProbes": 4,
      "stepMs": 250,
      "maxDelayMs": 30000,
      "idleAfterMs": 30000
    }
  },
  "housekeeping": {
    "enabled": true,
    "intervalSeconds": 300,
    "rollupLagSeconds": 120,
    "retention": {
      "rawDays": 40,
      "fiveMinuteDays": 365,
      "hourlyDays": 730,
      "dailyDays": 3650,
      "auditDays": 730
    },
    "compression": {
      "rawAfterDays": 7,
      "fiveMinuteAfterDays": 30
    },
    "disk": {
      "path": "",
      "evictBelowPercent": 10,
      "recoverAbovePercent": 15,
      "minimumRetainedHours": 48
    }
  },
  "probeEndpoint": {
    "host": "0.0.0.0",
    "port": 23560,
    "tls": {
      "certFile": "/etc/ms/tls/core.crt",
      "keyFile": "/etc/ms/tls/core.key",
      "caFile": "/etc/ms/tls/ca.crt"
    },
    "accessKeys": [],
    "handshakeTimeoutMs": 10000,
    "heartbeatIntervalMs": 10000
  }
}
