# MonitoringSystem core server.
#
# Production is a standalone native service, by design. No container
# runtime, no orchestrator. Install with deploy/install.sh.

[Unit]
Description=MonitoringSystem core server
Documentation=file:/opt/ms/docs
After=network-online.target postgresql.service
Wants=network-online.target
# **The restart loop ends, where an operator sees it** (P-215) — for a core killed at MemoryMax
# on every start, systemd refuses the sixth start inside ten minutes and leaves the unit
# `failed` with "start request repeated too quickly". This is safe for the core only because it no longer relies on restarts
# to wait for anything (P-215, P-222): a database that is not there yet is waited for inside the
# process, five minutes a round (packages/core/src/db/wait.ts), and so is a listen address not yet
# assigned; the migration lock and a long migration keep systemd waiting for as long as they last;
# and what only a person can fix — a password PostgreSQL refuses, a schema this build will not run
# against — exits 78, which is not restarted. A database that stays down puts at most two starts
# in any ten minutes. The table is in docs/administration.md, "What a start failure does".
# **A core in `failed` is silent**: it is the thing that raises alarms, so only something outside
# this system notices it. Three ways to be told are in docs/administration.md, "Watching the core
# from outside" (H-18): a check from another machine, the core's own heartbeat to a receiver you
# name (`heartbeat.url` in core.json, off until set), and a second OnFailure= in a drop-in, which
# adds to the one below. **And a core the limit stopped is started again** (H-23): ms-recover@ tries
# after 10 minutes, doubling to 4 hours, for as long as it keeps crashing. It never retries a core
# that exited 78, which fails differently. To keep it down, `systemctl disable ms-core`.
# After fixing the cause, `systemctl reset-failed ms-core` and start it.
StartLimitIntervalSec=600
StartLimitBurst=5
OnFailure=ms-recover@%N.service

[Service]
# Type=notify so systemd learns about readiness from the process rather than guessing, and so
# WatchdogSec has something to watch. NotifyAccess=all is required because Node cannot write to
# an AF_UNIX SOCK_DGRAM socket and we reach $NOTIFY_SOCKET through the systemd-notify helper
# (see packages/shared/src/lifecycle/systemd.ts).
Type=notify
NotifyAccess=all
TimeoutStartSec=60

# The service pings every 5 s, a sixth of this (P-243): a main thread held for 15 s under CPU
# starvation at the memory limit made a 15 s ping arrive 30.4 s after the one before, and the
# probe was killed for it. Raising WatchdogSec means a hung service is caught later instead.
WatchdogSec=30
Restart=on-failure
RestartSec=5s
# Exit 78 (EX_CONFIG) is a configuration the service refused to start with (P-215). Restarting
# reads the same file and refuses again, every five seconds, for ever; stopping at once puts the
# reason at the top of `systemctl status` instead of under a thousand copies of itself.
RestartPreventExitStatus=78

User=ms-core
Group=ms-core

Environment=NODE_ENV=production
Environment=MS_CONFIG_FILE=/etc/ms/core.json
ExecStart=/opt/ms/bin/ms-core

WorkingDirectory=/var/lib/ms-core
StateDirectory=ms-core
LogsDirectory=ms-core
RuntimeDirectory=ms-core

# **Do not edit this file: an upgrade replaces it** (H-21). It is the release's, in
# /usr/lib/systemd/system. Every change goes in a drop-in, which no upgrade touches:
#   systemctl edit ms-core      # writes /etc/systemd/system/ms-core.service.d/override.conf
#
# The database password can be an encrypted credential instead of a line in core.json; the config
# loader dereferences *__FROM_FILE. Create the credential, then put these two lines in the drop-in
# under [Service], and leave core.json's password empty:
#   systemd-creds encrypt --name=db-password plaintext /etc/ms/db-password.cred
#   LoadCredentialEncrypted=db-password:/etc/ms/db-password.cred
#   Environment=MS_DATABASE__PASSWORD__FROM_FILE=%d/db-password
# ms-backup reads core.json, so give it the password the way libpq takes one — see
# docs/runbook-backup-restore.md.

# Graceful shutdown: SIGTERM, drain, exit. Above service.shutdownTimeoutMs (default 20s) so
# nothing depends on it, but not the limit: the service tells systemd its budget as it stops
# (EXTEND_TIMEOUT_USEC, P-227), so a raised budget holds without editing this.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=30

# --- Hardening ---------------------------------------------------------------------------
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ReadWritePaths=/var/lib/ms-core /var/log/ms-core
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# V8 needs writable-executable pages for its JIT; this one cannot be enabled.
MemoryDenyWriteExecute=no

# --- Resource limits ---------------------------------------------------------------------
# Sized for the v1 target of 5,000 sensors on 8 cores / 16 GB (docs/sizing.md).
# One memory ceiling, and it kills: no MemoryHigh, for the reason ms-probe.service gives (P-213) —
# a throttled service stalls until the watchdog kills it, and restarts into the same stall. Core
# Health's `memoryLimitUsage` warns at 80% of it, which catches a core that has settled high or
# is leaking. Raise it on larger installations with `systemctl set-property ms-core MemoryMax=…`,
# which survives upgrades.
MemoryMax=8G
TasksMax=4096
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
