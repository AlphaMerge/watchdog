# MonitoringSystem: start ms-core or ms-probe again after it stopped for crashing (H-23).
#
# Not started by hand. Each service names it in OnFailure=, so systemd runs it when that service
# enters `failed`, and /opt/ms/bin/ms-recover decides. It acts only on a service the start limit
# stopped, and schedules one retry after a cool-down that doubles from 10 minutes to 4 hours. A
# configuration the service refused (exit 78) fails differently and is left for a person.
#
# **Do not edit this file: an upgrade replaces it** (H-21). Its decisions are in the journal:
#   journalctl -u 'ms-recover*'

[Unit]
Description=Start %i again after repeated crashes
Documentation=file:/opt/ms/docs

[Service]
Type=oneshot
# Root, because it asks systemd to reset and start another unit and to make a timer for it.
ExecStart=/opt/ms/bin/ms-recover %i
# Where the retry count is kept between failures. Kept after this one-shot exits, and gone at a
# reboot, which starts the services afresh anyway.
RuntimeDirectory=ms-recover
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
