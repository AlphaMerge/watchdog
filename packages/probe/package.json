{
  "name": "@ms/probe",
  "version": "1.0.0-rc.2",
  "private": true,
  "type": "module",
  "main": "./dist/src/main.js",
  "bin": {
    "ms-probe": "./dist/src/main.js"
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node ./dist/src/main.js",
    "pretest": "tsc -b",
    "pretest:perf": "tsc -b",
    "test": "npm run test:unit",
    "test:unit": "node --test \"dist/test/*.test.js\"",
    "test:perf": "node --test --test-concurrency=1 \"dist/test/perf/*.test.js\""
  },
  "dependencies": {
    "@ms/sensors": "1.0.0-rc.2",
    "@ms/shared": "1.0.0-rc.2"
  },
  "devDependencies": {
    "@ms/simulators": "1.0.0-rc.2"
  }
}
