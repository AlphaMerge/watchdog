{
  "name": "@ms/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/main.js",
  "bin": {
    "ms-core": "./dist/src/main.js"
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node ./dist/src/main.js",
    "pretest": "tsc -b",
    "pretest:perf": "tsc -b",
    "test": "npm run test:unit",
    "test:unit": "node --test \"dist/test/*.test.js\"",
    "test:perf": "node --test --test-concurrency=1 \"dist/test/perf/*.test.js\""
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.0.0",
    "@fastify/websocket": "^11.3.0",
    "@ms/sensors": "0.1.0",
    "@ms/shared": "0.1.0",
    "@prometheus-io/client": "0.16.1",
    "ajv": "^8.17.1",
    "argon2": "^0.45.1",
    "fastify": "^5.0.0",
    "nodemailer": "^9.0.5",
    "otpauth": "^9.5.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.18.1",
    "fast-check": "^4.9.0"
  }
}
