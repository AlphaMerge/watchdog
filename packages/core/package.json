{
  "name": "@ms/core",
  "version": "1.0.0-rc.2",
  "private": true,
  "type": "module",
  "main": "./dist/src/main.js",
  "bin": {
    "ms-core": "./dist/src/main.js"
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node ./dist/src/main.js",
    "pretest": "tsc -b",
    "pretest:perf": "tsc -b",
    "test": "npm run test:unit",
    "test:unit": "node --test --test-global-setup=dist/test/support/database-run.js \"dist/test/*.test.js\"",
    "test:perf": "node --test --test-concurrency=1 --test-global-setup=dist/test/support/database-run.js \"dist/test/perf/*.test.js\""
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.0.0",
    "@fastify/websocket": "^11.3.0",
    "@ms/sensors": "1.0.0-rc.2",
    "@ms/shared": "1.0.0-rc.2",
    "@prometheus-io/client": "0.16.1",
    "ajv": "^8.17.1",
    "argon2": "^0.45.1",
    "fastify": "^5.0.0",
    "fontkit": "^2.0.4",
    "nodemailer": "^10.0.1",
    "otpauth": "^9.5.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.9",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.18.1",
    "fast-check": "^4.9.0",
    "fast-xml-parser": "^5.11.1"
  }
}
