{
  "name": "@ms/web",
  "version": "1.0.0-rc.2",
  "private": true,
  "type": "module",
  "description": "Web UI, served as static assets by ms-core",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b ../shared && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b ../shared && tsc --noEmit",
    "pretest": "tsc -b ../shared && tsc --noEmit",
    "test": "vitest run",
    "predev": "tsc -b ../shared"
  },
  "dependencies": {
    "@ms/shared": "1.0.0-rc.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
