{
  "name": "@ms/sensors",
  "version": "1.0.0-rc.2",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./snmp": {
      "types": "./dist/src/support/snmp/index.d.ts",
      "default": "./dist/src/support/snmp/index.js"
    },
    "./syslog": {
      "types": "./dist/src/support/syslog/index.d.ts",
      "default": "./dist/src/support/syslog/index.js"
    },
    "./script": {
      "types": "./dist/src/support/script/index.d.ts",
      "default": "./dist/src/support/script/index.js"
    },
    "./windows": {
      "types": "./dist/src/support/windows/index.d.ts",
      "default": "./dist/src/support/windows/index.js"
    },
    "./ping": {
      "types": "./dist/src/support/ping.d.ts",
      "default": "./dist/src/support/ping.js"
    },
    "./flow": {
      "types": "./dist/src/support/flow/index.d.ts",
      "default": "./dist/src/support/flow/index.js"
    },
    "./pinned-target": {
      "types": "./dist/src/support/pinned-target.d.ts",
      "default": "./dist/src/support/pinned-target.js"
    },
    "./system-lookup": {
      "types": "./dist/src/support/system-lookup.d.ts",
      "default": "./dist/src/support/system-lookup.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "pretest": "tsc -b",
    "test": "node --test \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "@ms/shared": "1.0.0-rc.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fast-xml-parser": "^5.11.1",
    "mysql2": "^3.24.2",
    "net-snmp": "3.26.3",
    "pg": "^8.23.0",
    "ssh2": "1.17.0",
    "tedious": "^20.0.0"
  },
  "devDependencies": {
    "@ms/simulators": "1.0.0-rc.2",
    "@types/pg": "^8.11.0"
  }
}
